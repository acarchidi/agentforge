{
  "version": 2,
  "installCommand": "npm install --include=dev",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{public,dashboard}/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/internal/cron/watches",
      "schedule": "*/30 * * * *"
    }
  ]
}
